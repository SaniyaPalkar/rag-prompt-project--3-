PORT=5000

# Required: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-xxxxxxxx

# Optional model overrides (any OpenRouter model id)
CHAT_MODEL=meta-llama/llama-3.3-70b-instruct:free
EXTRACT_MODEL=meta-llama/llama-3.3-70b-instruct:free
VISION_MODEL=google/gemini-2.0-flash-exp:free

# Optional: free key from https://console.groq.com (needed only for audio transcription)
GROQ_API_KEY=



# MongoDB connection string.
# Local MongoDB:  mongodb://127.0.0.1:27017/notefusion
# Atlas (free):   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/notefusion
MONGODB_URI=mongodb://127.0.0.1:27017/notefusion

# Login security.
# Secret used to sign login tokens. For production generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If empty, one is generated on first run and saved in data/jwt-secret.txt.
JWT_SECRET=

# Where the frontend runs (used for CORS). Change this when you deploy.
CLIENT_ORIGIN=http://localhost:5173

# Set to production when deploying behind HTTPS (makes the login cookie Secure).
# NODE_ENV=production
